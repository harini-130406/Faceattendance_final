# ==============================================================================
# Smart Attendance System - Production Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR PRODUCTION SECRETS
# DO NOT COMMIT THE ACTUAL .env FILE TO GIT
# ==============================================================================

# Core Django Settings
# Set DEBUG to False in production
DEBUG=False
# Generate a new 50+ character random string for production SECRET_KEY
SECRET_KEY=your-production-secret-key-change-this-value-before-deploying

# Persistent Volume Storage Root (e.g. Railway Persistent Volume mount path)
# Default for local development is 'media/' inside the project directory
MEDIA_ROOT=/data/media

# Allowed Hosts (comma-separated domains and IPs)
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com

# Database URL (PostgreSQL in production)
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://attendance_user:change_to_db_password@localhost:5432/attendance_production_db

# Email Configuration (Password Reset & Security Alerts)
# Option A: Brevo HTTPS REST API (Recommended for Railway - Port 443 never blocked by cloud firewalls)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=proconnect795@gmail.com
BREVO_SENDER_NAME=Smart FaceAttendance

# Option B: Standard SMTP Relay (Gmail or Brevo SMTP)
EMAIL_BACKEND=attendence_sys.email_backend.SmartFailoverEmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=proconnect795@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password_here
DEFAULT_FROM_EMAIL=proconnect795@gmail.com
SERVER_EMAIL=proconnect795@gmail.com

# CORS Configuration (comma-separated allowed web origins)
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# CSRF Trusted Origins (comma-separated)
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com

# Production Security Flags (Optional Overrides)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
